{
	"name": "@nahu/admin-kit",
	"version": "0.1.13",
	"private": true,
	"description": "The dashboard, table, form, filter, CRUD and file-storage pieces shared across my SvelteKit projects.",
	"type": "module",
	"bin": {
		"admin-kit": "bin/setup.js"
	},
	"scripts": {
		"dev": "vite dev",
		"package": "svelte-kit sync && svelte-package && publint",
		"package:watch": "svelte-kit sync && svelte-package --watch",
		"prepare": "svelte-kit sync && svelte-package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test": "vitest --run",
		"test:server": "vitest --run --project server",
		"test:client": "vitest --run --project client",
		"postinstall": "node bin/setup.js --postinstall",
		"release": "npm version patch --no-git-tag-version"
	},
	"files": [
		"dist",
		"bin",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./styles/*.css": "./dist/styles/*.css",
		"./*.svelte": {
			"types": "./dist/*.svelte.d.ts",
			"svelte": "./dist/*.svelte",
			"default": "./dist/*.svelte"
		},
		"./*.js": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"svelte": "./dist/*.js",
			"default": "./dist/*.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.50.0",
		"drizzle-orm": "^0.45.0",
		"svelte": "^5.49.0",
		"tailwindcss": "^4.1.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^0.562.0",
		"@tanstack/table-core": "^8.21.3",
		"bits-ui": "^2.18.1",
		"browser-image-compression": "^2.0.2",
		"chart.js": "^4.5.1",
		"clsx": "^2.1.1",
		"ethiopian-calendar-new": "^1.1.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"papaparse": "^5.5.3",
		"pluralize": "^8.0.0",
		"svelte-sonner": "^1.1.1",
		"sveltekit-flash-message": "^2.4.6",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^25.9.1",
		"@types/papaparse": "^5.5.2",
		"@types/pluralize": "^0.0.33",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-orm": "^0.45.2",
		"mysql2": "^3.22.4",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"publint": "^0.3.15",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.5",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
